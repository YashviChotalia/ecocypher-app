{
  "name": "EcoCypher Companion",
  "short_name": "EcoCypher",
  "description": "Scan, verify and check sustainability evidence.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#FAF6EA",
  "theme_color": "#14583F",
  "categories": ["utilities", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Scan a QR receipt", "url": "/#/scan", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Check a claim", "url": "/#/check", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
