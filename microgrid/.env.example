# Copy to microgrid/.env (never committed). deploy-catalyst.ps1 sends these to AppSail on every deploy.
# QuickML published endpoint (QuickML > Endpoints > your endpoint > details)
QUICKML_ENDPOINT_URL=
QUICKML_ENDPOINT_KEY=
QUICKML_ORG_ID=
QUICKML_ENVIRONMENT=Development
# Either a short-lived access token (scope QuickML.deployment.READ) ...
QUICKML_ACCESS_TOKEN=
# ... or a Self Client refresh token so the app refreshes access tokens itself (recommended)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
# Optional persistence
DATASTORE_TABLE=forecast_runs
STRATUS_BUCKET=
